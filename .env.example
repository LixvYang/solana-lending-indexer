# 联网剧本与钱包工具使用；离线测试不需要。API 只读取 RPC_URL，不读取 ANCHOR_WALLET。
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
ANCHOR_WALLET=/absolute/path/to/deployer-wallet.json

# 可选:Switchboard Crossbar 地址(默认 https://crossbar.switchboardlabs.xyz)
# CROSSBAR_URL=

# M7a：全部可选；勿把真实密钥文件或 .env 入库。
# FAUCET_URL=http://localhost:8788/faucet
# FAUCET_KEYPAIR=/absolute/path/to/faucet.keypair.json
# FAUCET_PORT=8788
# FAUCET_TUSDC_AMOUNT=1000
# FAUCET_TSOL_AMOUNT=10
# FAUCET_DAILY_MAX=2000
# faucet-setup 每次补充的总量(UI 单位)
# FAUCET_SETUP_SOL=2
# FAUCET_SETUP_TUSDC=2000000
# FAUCET_SETUP_TSOL=20000
